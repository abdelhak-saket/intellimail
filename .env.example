# Azure OpenAI — copier dans .env et adapter
# NE JAMAIS mettre de vraie clé dans ce fichier (il est versionné).
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com
AZURE_OPENAI_API_KEY=<votre-cle-api>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Deployments
LLM_CLASSIFIER=gpt-4.1-mini
LLM_DRAFTER=gpt-4.1-mini
LLM_CRITIC=gpt-4.1-mini

# Workflow
MAX_DRAFTER_RETRIES=2
CRITIC_APPROVE_THRESHOLD=0.75
SEUIL_AUTO=0.85
SEUIL_HITL=0.70

# Règles déterministes — table dans rules.py
# spam/autre inclus : on ne répond jamais à un phishing ni à un e-mail non classé
HITL_FORCE_CATEGORIES=reclamation,resiliation,donnees_personnelles,spam,autre
# Une urgence n'est jamais traitée automatiquement
HITL_FORCE_PRIORITIES=haute
# Détection regex d'opérations sensibles (RIB, procuration, décès, fraude...)
SENSITIVE_RULES_ENABLED=true
# Garde-fou de sortie : inspecte le brouillon (code promo injecté, lien, méta-IA)
OUTPUT_GUARDRAIL_ENABLED=true

# Entrée dégénérée : corps < N caractères → HITL direct sans appel LLM
DEGENERATE_MIN_CHARS=15

# Coût estimé (USD / 1M tokens) — défauts gpt-4.1-mini
PRICE_INPUT_PER_1M=0.40
PRICE_OUTPUT_PER_1M=1.60

# Idempotence par message-id
IDEMPOTENCY_TTL_S=3600
IDEMPOTENCY_MAX_ENTRIES=1000

# RAG ChromaDB (ingestion : python ingest_corpus.py)
CHROMA_DIR=chroma_db
RAG_TOP_K=3
# Vide = embedding local ChromaDB ; sinon deployment Azure (ex. text-embedding-3-small)
EMBEDDING_DEPLOYMENT=

# Tracing LangSmith (benchmark / observabilité) — optionnel
# Créer une clé sur https://smith.langchain.com puis décommenter :
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<votre-cle-langsmith>
# LANGSMITH_PROJECT=intellimail-poc

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Clé d'API. Vide = pas d'authentification (local uniquement).
# À RENSEIGNER avant d'exposer l'API par un tunnel (Copilot Studio / Power
# Automate) — sinon l'URL publique est ouverte à tous.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
